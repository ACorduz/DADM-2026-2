<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:defaultValue="1"
        app:key="radius"
        app:title="@string/pref_radius_title"
        app:useSimpleSummaryProvider="true" />

    <ListPreference
        app:defaultValue="amenity=hospital"
        app:entries="@array/category_entries"
        app:entryValues="@array/category_values"
        app:key="category"
        app:title="@string/pref_category_title"
        app:useSimpleSummaryProvider="true" />

</PreferenceScreen>
